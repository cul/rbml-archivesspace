		{
			"jsonmodel_type": "note_multipart",
			"persistent_id": "87763706e992b839715890cfbcd7eeea",
			"label": "Immediate Source of Acquisition",
			"type": "acqinfo",
			"subnotes": [
				{
					"jsonmodel_type": "note_text",
					"content": "Source of acquisition--New York City Opera. Method of acquisition--Deposit (converted to gift in 2021); Date of acquisition--2013. Accession number--2013-2014-M073.",
					"publish": true
				}
			],
			"publish": true
		},
		{
			"jsonmodel_type": "note_multipart",
			"persistent_id": "7fa6e0358646882980e9c3f339077b1d",
			"type": "acqinfo",
			"subnotes": [
				{
					"jsonmodel_type": "note_text",
					"content": "Gift of James H. North, addition, 2021.",
					"publish": true
				}
			],
			"publish": true
		},
		{
			"jsonmodel_type": "note_multipart",
			"persistent_id": "c20c9f00da9ee3f5d0b3482e235b8688",
			"type": "bioghist",
			"subnotes": [
				{
					"jsonmodel_type": "note_text",
					"content": "New York City Opera (NYCO) was famously dubbed \"The People's Opera\" by Mayor Fiorello LaGuardia at its founding in 1943. The Opera's mission is to inspire audiences with innovative and theatrically compelling opera at an affordable price.",
					"publish": true
				}
			],
			"publish": true
		},
		{
			"jsonmodel_type": "note_multipart",
			"persistent_id": "7504d92412fa1bcfe782b795fb737c1d",
			"type": "custodhist",
			"subnotes": [
				{
					"jsonmodel_type": "note_text",
					"content": "Processed portion: \n\n2013.2014.M073: The records came from the storage at the Lincoln Center State Theater and were delivered to the Butler Library without notice just before NYCO declared bankruptcy during October 2013. The boxes arrived in two very large wooden bins marked NYC Ballet. The boxes were unpacked by Patrick Lawlor and stored on site. These were processed as box 1-230 in 2021-2022 by Yingwen Huang. The James North addition (2020.2021.M072) were also processed along with this portion.\n\nUnprocessed portion:\n\nA total of 291.6 cubic feet of NYC opera records were severely damaged during Hurricane Sandy in 2012. NYCO received funding from FEMA to rescue the records and for digitization. The undamaged paper materials comprise 176 boxes. They have been scanned by Scantek in Willow Grove, Pa. onto 2 hard discs. Scantek scanned the dry boxes that were located near the Battery and moved to a higher floor. The physical boxes went to ReCAP and they are mostly Administrative/Business files (2014-2015-M040). The damaged records were scanned by Polygon. They scanned the wet/oily boxes that were two floors below ground when the hurricane hit after the elevator broke. The physical records were discarded after digitization. The Digital Accessions are: 2013.2014.M109.DIGITAL, 2013.2014.M111.DIGITAL, 2014.2015.M049.DIGITAL, 2014.2015.M117.DIGITAL.",
					"publish": true
				}
			],
			"publish": true
		},
		{
			"jsonmodel_type": "note_multipart",
			"persistent_id": "704e4f39b0932baa5704aa638073cd1d",
			"label": "Preferred Citation",
			"type": "prefercite",
			"subnotes": [
				{
					"jsonmodel_type": "note_text",
					"content": "Identification of specific item; Date (if known); New York City Opera records; Box and Folder; Rare Book and Manuscript Library, Columbia University Library.",
					"publish": true
				}
			],
			"publish": true
		},
		{
			"jsonmodel_type": "note_multipart",
			"persistent_id": "c1ad2eedca8455ed516edc5b9551ed9c",
			"label": "Processing Information",
			"type": "processinfo",
			"subnotes": [
				{
					"jsonmodel_type": "note_text",
					"content": "Collection-level record describing unprocessed material made public in summer 2018 as part of the Hidden Collections initiative.",
					"publish": true
				}
			],
			"publish": true
		},
		{
			"jsonmodel_type": "note_multipart",
			"persistent_id": "a429e779a736c8390b704eac9d71de05",
			"type": "relatedmaterial",
			"subnotes": [
				{
					"jsonmodel_type": "note_text",
					"content": "Julius Rudel papers 1945-2015. The New School Archives and Special Collections.\n\nJack Beeson papers; Rare Book and Manuscript Library, Columbia University Library.\n\nNew York Public Library also has collections and materials related to NYCO:\n\nMorton Baum Papers, 1938-1968 *LPA Mss 1992-001 . Jerome Robbins Dance Division, The New York Public Library for the Performing Arts.\n\nImages of the New York City Opera / by Fred Fehl, ca. 1940-1980, Music Division, The New York Public Library.\n\nPlot summaries, recorded by the New York City Opera, Rodgers and Hammerstein Archives of Recorded Sound, The New York Public Library.",
					"publish": true
				}
			],
			"publish": true
		},
		{
			"jsonmodel_type": "note_multipart",
			"persistent_id": "6080aed35c3ccee00d2c4e555f6384b6",
			"label": "Summary",
			"type": "scopecontent",
			"subnotes": [
				{
					"jsonmodel_type": "note_text",
					"content": "New York City Opera records consist of administrative, financial, production, business records, including contracts, stage guides, opera scores, programs, playbills, photographs, posters, memorabilia, and audio-visual materials, dating from 1943 to 2014.",
					"publish": true
				}
			],
			"publish": true
		},
		{
			"jsonmodel_type": "note_multipart",
			"persistent_id": "f043670b2cda67f9430a9a5978855aab",
